# hacksexy.online — serve React build (SPA)
#
# Trên VPS:
#   1) Build FE với .env production (auth + api subdomain)
#   2) sudo cp fe/deploy/nginx-fe.conf.example /etc/nginx/sites-available/hacksexy.online
#   3) Sửa root → path tới thư mục build thật
#   4) sudo ln -sf /etc/nginx/sites-available/hacksexy.online /etc/nginx/sites-enabled/
#   5) sudo nginx -t && sudo systemctl reload nginx
#
# Cloudflare DNS:
#   A  @    → IP VPS (Proxied)
#   A  www  → IP VPS (Proxied)
#
# FE .env (build trước khi npm run build):
#   REACT_APP_URL_API=https://auth.hacksexy.online
#   REACT_APP_URL_API_CASINO=https://api.hacksexy.online

server {
    listen 80;
    listen [::]:80;
    server_name hacksexy.online www.hacksexy.online;
    return 301 https://www.hacksexy.online$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hacksexy.online;

    ssl_certificate     /etc/nginx/ssl/hacksexyonline/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/hacksexyonline/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://www.hacksexy.online$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.hacksexy.online;

    ssl_certificate     /etc/nginx/ssl/hacksexyonline/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/hacksexyonline/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/hacksexy/hacksexy-fe/build;
    index index.html;

    client_max_body_size 10m;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /static/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
